generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RenewalPlan {
  monthly
  biweekly
  weekly
}


enum Status {
  active
  cancelled
  paused
  expired
  pending
  payment_failed
}

model User{
  id String @id @default(uuid())
  stripeId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  email String @unique 
  password String 
  firstName String?
  lastName String?
  phone String? @unique
  phoneVerified Boolean? @default(false)
  bio String?
  profilePicture String?
  isActive Boolean @default(true)
  @@map("users")
  products Product[]
  subscription Subscription[]
  userRoles UserRole[]
  orders Order[]
  auditLogs AuditLog[]
  notifications NotificationEvent[]
  shippingAddresses ShippingAddress[]  // Add this line
}

model Product{
  id               String    @id @default(uuid())
  stripeId        String?   @unique
  name             String 
  description      String?
  pricingTiers     PricingTier[]
  stock            Int       @default(0)
  allowBackorder   Boolean   @default(false)
  curatorId        String 
  maxSubscribers   Int?
  category         String?
  availablePlans RenewalPlan[] 
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt()
  
  user         User          @relation(fields: [curatorId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  boxItems     BoxItem[]
  orderItems   OrderItem[]
  @@map("products")
}
model PricingTier{
  id String @id @default(uuid())
  productId String
  stripeId String? @unique
  plan RenewalPlan
  minQuantity Int
  maxQuantity Int?
  pricePerUnit Float
  isActive Boolean @default(true)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@unique([productId, plan, minQuantity])
  @@map("pricing_tiers")
}

model Subscription {
  id              String      @id @default(uuid())
  subscriberId    String 
  productId       String
  stripeSubscriptionId String? @unique 
  status          Status
  startDate       DateTime    @default(now())
  nextBillingDate DateTime
  lastBillingDate DateTime?
  chosenPlan     RenewalPlan  
  autoRenew       Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt()
  quantity        Int

  user           User            @relation(fields: [subscriberId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade) 
  orders         Order[]
  paymentRecords PaymentRecord[]
  @@map("subscriptions")
  
}

model BoxItem {
  id          String   @id @default(uuid())
  productId   String
  name        String
  description String?
  quantity    Int
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("box_items")
}


model Role{
  id Int @id 
  role String
  description String
  userRoles UserRole[]
}

model UserRole{
  id Int @id @default(autoincrement())
  roleId Int
  userId String
  role Role @relation(fields:[roleId],references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id            String      @id @default(uuid())
  userId        String
  subscriptionId String?
  totalAmount   Float
  status        OrderStatus
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt()
  shippingAddressId String
  
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  orderItems   OrderItem[]
  paymentRecords PaymentRecord[]
  shippingAddress ShippingAddress @relation(fields: [shippingAddressId],references: [id])
  @@map("orders")
}

model OrderItem {
  id        String @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@map("order_items")
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
}
model PaymentRecord {
  id              String        @id @default(uuid())
  orderId         String?
  subscriptionId  String?
  amount          Float
  currency        String        @default("USD")
  status          PaymentStatus
  paymentMethod   String
  stripePaymentId String?
  createdAt       DateTime      @default(now())
  
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@map("payment_records")
}

enum PaymentStatus {
  pending
  succeeded
  failed
  refunded
}

model NotificationEvent {
  id          String            @id @default(uuid())
  type        NotificationType
  recipientId String
  payload     Json
  sentAt      DateTime?
  channel     NotificationChannel
  status      NotificationStatus @default(pending)
  createdAt   DateTime          @default(now())
  
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  @@map("notification_events")
}

enum NotificationType {
  SUBSCRIPTION_CONFIRMED
  PAYMENT_FAILED
  PRODUCT_REMOVED
  SHIPPING_NOTIFICATION
  LOW_STOCK_ALERT
}

enum NotificationChannel {
  email
  sms
  websocket
  push
}

enum NotificationStatus {
  pending
  sent
  failed
}
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  resource  String
  resourceId String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("audit_logs")
}

model ShippingAddress {
  id        String   @id @default(uuid())
  userId    String
  firstName String
  lastName  String
  company   String?
  address1  String
  city      String
  state     String
  postalCode String
  phone     String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt()
  
  order Order[]
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("shipping_addresses")
}