---------------------------------
id: UUID
productId: UUID
scheduledFor: timestamp
status: enum('scheduled', 'processing', 'completed')
packingListGenerated: boolean
trackingNumbers: JSONB (optional future)

// Notes:
// - Created by @nestjs/schedule cron job per shipping cycle
